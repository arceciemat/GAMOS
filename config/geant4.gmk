# Geant4 11.4.p03 (instalado con CMake, librerias globales/por categoria)
#   cabeceras : $(G4INSTALL)/include/Geant4
#   librerias : $(G4INSTALL)/lib/$(G4SYSTEM)
# Version anterior (Geant4 11.01, librerias granulares): geant4.gmk.11.01

INCFLAGS += -I$(GAMOSINSTALL)/source 
INCFLAGS += -I$(G4INSTALL)/include/Geant4
INCFLAGS += -I$(G4INSTALL)/include
INCFLAGS += -I$(G4INSTALL)/source/externals/ptl/include
INCFLAGS += -I$(G4INSTALL)/source/externals/g4tools/include

G4LIBPATH := $(G4INSTALL)/lib/$(G4SYSTEM)

ifndef EXTRALIBS
EXTRALIBS := -L$(G4LIBPATH)
else 
EXTRALIBS += -L$(G4LIBPATH)
endif
EXTRALIBS += -Wl,-rpath,$(G4LIBPATH)

EXTRALIBS += -lG4physicslists -lG4readout -lG4error_propagation -lG4analysis \
             -lG4interfaces -lG4RayTracer -lG4VRML -lG4Tree -lG4FR -lG4GMocren \
             -lG4ToolsSG -lG4vis_management -lG4modeling \
             -lG4geomtext -lG4mctruth -lG4run -lG4event -lG4tracking -lG4parmodels \
             -lG4processes_hadronic -lG4processes_core -lG4digits_hits -lG4track \
             -lG4particles -lG4geometry -lG4materials -lG4graphics_reps \
             -lG4intercoms -lG4global -lG4ptl -lG4clhep -lG4zlib \
             -lexpat -lm -lstdc++ -lpthread

# OpenGL solo si Geant4 se ha compilado con el (GEANT4_USE_OPENGL_X11=ON)
ifdef G4VIS_USE_OPENGL
ifneq ($(wildcard $(G4LIBPATH)/libG4OpenGL.so),)
EXTRALIBS += -lG4OpenGL -lGLU -lGL -lXmu -lXt -lXext -lX11 -lXi -lSM -lICE 
endif
endif

# binmake.gmk añade por su cuenta listas de librerias de Geant4 (VISLIBS, UILIBS,
# -lG4persistency, -lG4processes, -lG4gl2ps, -lG4visHepRep, liblist granular...)
# que no existen en 11.4. Todas las de Geant4 van ya en EXTRALIBS.
LDLIBS2 :=
LDLIBS2EXTRA :=
LDLIBS3 :=
