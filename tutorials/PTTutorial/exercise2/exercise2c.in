# VERBOSITY 
/tracking/verbose 0

# GEOMETRY
/gamos/setParam GmGeometryFromText:FileName ../exercise1/phantomBox.geom
/gamos/geometry GmGeometryFromText

# PHYSICS
/gamos/physicsList G4QGSP_BIC_HP

# PRIMARY GENERATOR
/gamos/generator GmGenerator

# GEANT4 INITIALISATION
/run/initialize

# SOURCE
/control/execute ../exercise1/pbsSource.in

# STATISTICS
/gamos/userAction GmCountTracksUA

#---------- exercise 2c ----------

# HISTOGRAMMING
#/gamos/analysis/histo1Max * 250
#/gamos/analysis/histo2NBinsX * 120
#/gamos/analysis/histo1NBins * 125
#/gamos/analysis/histo2MinX * -9
#/gamos/analysis/histo2MaxX * 3
#/gamos/analysis/histo2MaxY * 20
/P secoParticleC:OnSecondary 1
/gamos/classifier secoParticleC GmClassifierByParticle
/gamos/setParam GmSecondaryTrackDataHistosUA_GmPrimaryFilter_secoParticleC:FileName Direction_primSecos
/gamos/setParam GmSecondaryTrackDataHistosUA_GmPrimaryFilter_secoParticleC:DataList FinalPrimSecoAngle FinalPrimKineticEnergy.vs.FinalPrimSecoAngle
/gamos/userAction GmSecondaryTrackDataHistosUA GmPrimaryFilter secoParticleC
#---------------------------------

# RUN  SIMULATION
/run/beamOn 10000
