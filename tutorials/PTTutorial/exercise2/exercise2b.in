# VERBOSITY 
/tracking/verbose 0

# GEOMETRY
/gamos/setParam GmGeometryFromText:FileName ../exercise1/phantomBox.geom
/gamos/geometry GmGeometryFromText

# PHYSICS
/gamos/physicsList G4QGSP_BIC_AllHP

# PRIMARY GENERATOR
/gamos/generator GmGenerator

# GEANT4 INITIALISATION
/run/initialize

# SOURCE
/control/execute ../exercise1/pbsSource.in

# STATISTICS
/gamos/userAction GmCountTracksUA

#---------- exercise 2b ----------
# FILTERS
/gamos/filter exitPhantomFilter GmExitLogicalVolumeFilter phantomBox
/gamos/filter exitGammaFilter GmANDFilter exitPhantomFilter GmGammaFilter
/gamos/filter exitNeutronFilter GmANDFilter exitPhantomFilter GmNeutronFilter

# HISTOGRAMMING
/gamos/setParam GmStepDataHistosUA_exitGammaFilter_GmClassifierByCreatorProcess:FileName Ekin_exitGamma
/gamos/setParam GmStepDataHistosUA_exitGammaFilter_GmClassifierByCreatorProcess:DataList FinalKineticEnergy
/gamos/analysis/histo1Max GmStepDataHistosUA_exitGammaFilter_GmClassifierByCreatorProcess:*:FinalKineticEnergy 250
/gamos/analysis/histo1NBins GmStepDataHistosUA_exitGammaFilter_GmClassifierByCreatorProcess:*:FinalKineticEnergy 125
/gamos/userAction GmStepDataHistosUA exitGammaFilter GmClassifierByCreatorProcess

/gamos/setParam GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:FileName Ekin_exitNeutron
/gamos/setParam GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:DataList FinalKineticEnergy log10(FinalKineticEnergy)
/gamos/analysis/histo1Max GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:*:FinalKineticEnergy 250
/gamos/analysis/histo1NBins GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:*:FinalKineticEnergy 125
/gamos/analysis/histo1Min GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:*:log10(FinalKineticEnergy) -9
/gamos/analysis/histo1Max GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:*:log10(FinalKineticEnergy) 3
/gamos/analysis/histo1NBins GmStepDataHistosUA_exitNeutronFilter_GmClassifierByCreatorProcess:*:log10(FinalKineticEnergy) 120
/gamos/userAction GmStepDataHistosUA exitNeutronFilter GmClassifierByCreatorProcess
#---------------------------------

# RUN  SIMULATION
/run/beamOn 100000
