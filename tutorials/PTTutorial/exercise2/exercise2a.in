# VERBOSITY 
/tracking/verbose 0

# GEOMETRY
/gamos/setParam GmGeometryFromText:FileName ../exercise1/phantomBox.geom
/gamos/geometry GmGeometryFromText

# PHYSICS
/gamos/physicsList G4QGSP_BIC_HP

# PRIMARY GENERATOR
/gamos/generator GmGenerator

# GEANT4 INITIALISATION
/run/initialize

# SOURCE
/control/execute ../exercise1/pbsSource.in

# STATISTICS
/gamos/userAction GmCountTracksUA

#---------- exercise 2a ----------
# FILTER "EXIT PHANTOM"
/gamos/filter exitPhantomFilter GmExitLogicalVolumeFilter phantomBox

# ENERGY HISTOGRAMS
/gamos/setParam GmStepDataHistosUA_exitPhantomFilter_GmClassifierByParticle:FileName Ekin_exitPhantom
/gamos/setParam GmStepDataHistosUA_exitPhantomFilter_GmClassifierByParticle:DataList FinalKineticEnergy
/gamos/analysis/histo1Max GmStepDataHistosUA_exitPhantomFilter_GmClassifierByParticle:*:FinalKineticEnergy 250
/gamos/analysis/histo1NBins GmStepDataHistosUA_exitPhantomFilter_GmClassifierByParticle:*:FinalKineticEnergy 125
/gamos/userAction GmStepDataHistosUA exitPhantomFilter GmClassifierByParticle
#---------------------------------

# RUN  SIMULATION
/run/beamOn 10000
