# VERBOSITY 
/tracking/verbose 0

# GEOMETRY
/gamos/setParam GmGeometryFromText:FileName ./phantomBox.geom
/gamos/geometry GmGeometryFromText

# PHYSICS
/gamos/physicsList G4QGSP_BIC_AllHP

# PRIMARY GENERATOR
/gamos/generator GmGenerator

# GEANT4 INITIALISATION
/run/initialize

# SOURCE
/control/execute ./pbsSource.in

# STATISTICS
/gamos/userAction GmCountTracksUA

#---------- exercise 0b ----------
# FILTER "IN PHANTOM"
/gamos/filter inPhantomFilter GmInLogicalVolumeFilter phantomBox

# COUNT PROCESSES AND PARTICLES IN THE PHANTOM
/gamos/userAction GmCountProcessesUA inPhantomFilter

# SIMULATION
/run/beamOn 1000
