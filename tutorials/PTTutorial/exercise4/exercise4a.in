#/gamos/verbosity GmScoringVerbosity test

/gamos/setParam GmAnalysisMgr:FileNameSuffix _.patient

/P GmReadPhantomGeometry:Phantom:DensityNSplit 10
/gamos/setParam GmReadPhantomGeometry:RecalculateMaterialDensities 1
/gamos/setParam GmReadPhantomGeometry:FileName world.geom
/gamos/setParam GmReadPhantomGeometry:Phantom:FileName testCT.g4dcm4x
/gamos/setParam GmReadPhantomGeometry:InitialRotAngles -90*deg 0. 0. #HFS (HeadFirstSupine)

/gamos/geometry GmReadPhantomG4Geometry

/gamos/physicsList G4QGSP_BIC_HP

/gamos/generator GmGenerator

/run/initialize

/gamos/setParam source:ControlPointFileNamePrefix RTIonPlanControlPoint
/gamos/setParam source:BeamFileNamePrefix RTIonPlanBeam
/gamos/setParam source:PlanFileNamePrefix RTIonPlan 
/gamos/setParam source:MSUnitsToSkip 0 
/gamos/setParam source:MSUnitsToRun 0.242539
/gamos/generator/addRTIonPlanScanSpotSource source proton
/gamos/generator/positionDist source GmGenerDistPositionDiscGaussian 3.0 0. 0. -510. 
/gamos/generator/directionDist source GmGenerDistDirectionCone 0. 0. 1. 4.*mrad

/P GmGenerDistEnergyFromMultiFileE:FileListName enerDist.INCLXX.lis /
/gamos/generator/energyDist source GmGenerDistEnergyConstant 146.1
#/gamos/generator/RTPlan/associateBeamVolumes source rangeShifter 

/P GmCountTracksUA:EachNEvent 1000
/gamos/userAction GmCountTracksUA
#/gamos/userAction GmCountProcessesUA

/gamos/scoring/createMFDetector Det phantom 
#DOSE SCORER AND PRINTERS
/P sqdoseDose_doseScorer:FileName sqdose_dose
/gamos/scoring/addScorer2MFD doseScorer GmPSDoseDeposit Det
/gamos/scoring/printer sqdoseDose GmPSPrinterSqdose
/gamos/scoring/addPrinter2Scorer sqdoseDose doseScorer
#/gamos/scoring/addPrinter2Scorer GmPSPrinterCout doseScorer

#LET SCORER GmPSLET_dEdx_unrestrD
/P sqdoseLETDu_LETDuScorer:FileName sqdose_LETDu     
#/gamos/scoring/addScorer2MFD LETDuScorer GmPSLET_dEdx_unrestrD Det
/gamos/scoring/addScorer2MFD LETDuScorer GmPSEnergyDeposit Det
/gamos/scoring/addFilter2Scorer GmProtonFilter LETDuScorer
/gamos/scoring/printNEventsType LETDuScorer ByNFilled
/gamos/scoring/printer sqdoseLETDu GmPSPrinterSqdose
/gamos/scoring/addPrinter2Scorer sqdoseLETDu LETDuScorer


/gamos/random/restoreSeeds 1138 1138

#/tracking/verbose 1
/run/beamOn 100000

