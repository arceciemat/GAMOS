#/tracking/verbose 1

/gamos/setParam GmAnalysisMgr:FileNameSuffix .dnadamage
/gamos/setParam GmGeometryFromText:FileName world.geom
/gamos/geometry GmGeometryFromText
/gamos/physicsList GmEmDNAPhysics
#/gamos/GmDNAPhysics/replacePhysics DNA_option2

/gamos/generator GmGenerator


/run/initialize 
#
#/control/execute vis.mac
#
/gamos/generator/addSingleParticleSource source e-  1*keV

/gamos/userAction DNAyzRunAction

/gamos/userAction GmCountProcessesUA
/gamos/setParam GmCountTracksUA:EachNEvent 1
/gamos/userAction GmCountTracksUA
#
/gamos/random/setSeeds 1111 1111

#/P GmStepDataTextFileUA:DataList EventID TrackID ParentTrackID StepNumber ParticleType FinalProcess InitialPosX InitialPosY InitialPosZ AccumulatedEnergyDeposited KineticEnergyChange DNAInitialVolumeType InitialPVCopyNumber EventID
#/gamos/setParam GmStepDataTextFileUA:DataList InitialPosX/1e-6 InitialPosY/1e-6 InitialPosZ/1e-6 AccumulatedEnergyDeposited/eV KineticEnergyChange/eV DNAInitialVolumeType InitialPVCopyNumber EventID TrackID ParentTrackID StepNumber Particle FinalProcess
/gamos/userAction GmStepDataTextFileUA 

/gamos/SD/assocSD2LogVol DNAyzTrackerSD yzSD world

#/gamos/physics/userLimits UL1 world * 1e9 1e9 1e9 11*eV

/run/beamOn 100

#/gamos/geometry/printVolumeTree 222
#/gamos/geometry/printTouchables *
