
INITIALISE
----------
### GEOMETRY
1. DNADamDetectorConstruction::DNADamDetectorConstruction()
  1.0. Create world +-200*nm**3
  1.1. new DNADamParser
    1.1.1. create G4MoleculeGun (fpGun) : ## will be passed to G4DNAChemistryManager
  1.2 DNADamParser->ParseFile("VoxelStraight.fab2g4dna");
    1.2.1. Read number of nucleosomes, linkers and base pairs
    1.2.2. Read molecule radii
    1.2.3. Read linkers and nucleosomes element placements
    1.2.4. Fille fpGun with all molecules (just names and positions)
  1.3. fpGun = fpDNADamParser->ReleaseMoleculeGun();
  1.4. this->RegisterParallelWorld(new DNADamParallelWorld("ChemistryWorld"));
2. DNADamDetectorConstruction::Construct
  2.1. fpDNADamParser->CreateLogicVolume(); ## creates molecule G4Volumes (most using G4SubtractionSolid because molecules overlap)
  2.2. fGeometryMap = fpDNADamParser->ReleaseGeoData();
3. DNADamParallelWorld::Construct()
  3.1. DNADamParallelWorld::SetupChemistryGeometry()
   # simple world +-200*nm**3 of G4_WATER
4. DNADamStackingAction::NewStage()
     - Assigns DNADamParallelWorld to G4ITTransportationManager 
## GEOM SUMMARY:
   - DNADamDetectorConstruction invokes DNADamParser
   - DNADamParser creates molecule G4Volumes
     chemistry of molecule volumes (indeed just name and positions) will be managed by a G4MoleculeGun created at DNADamParser with all molecules, and assigned to G4DNAChemistryManager in DNADamRunAction::DNADamRunAction()
   - DNADamParallelWorld creates a 200*nm**3 of G4_WATER world, which is assigned to G4ITTransportationManager by DNADamStackingAction::NewStage()

### PHYSICS & CHEMISTRY 
1. DNADamPhysicsList invokes   G4EmDNAChemistry_option2
 1.1. G4EmDNAChemistry_option2::ConstructMolecule() # G4H2O, G4Adenine, G4DamagedThymine, ...
 1.2. G4EmDNAChemistry_option2::ConstructDissociationChannels() 
    //Define the decay channels for Excitation, Ionisation, Dissociative Attachment, Electron-hole recombination
    For each decay channel: set excitation energy, probability, displacement
    G4MolecularConfiguration* H3Op = G4MoleculeTable::Instance()->GetConfiguration("H3Op"); ...
 1.3. G4EmDNAChemistry_option2::ConstructReactionTable()
    // e_aq + e_aq + 2H2O -> H2 + 2OH-   
    // e_aq + *OH -> OH-
    // e_aq + H* + H2O -> H2 + OH-
    // e_aq + H3O+ -> H* + H2O
    // e_aq + H2O2 -> OH- + *OH
    // *OH + *OH -> H2O2
    // *OH + *H -> H2O
    // *H + *H -> H2
    // H3O+ + OH- -> 2H2O
    // 2-Deoxyribose + OH -> damagedDeoxyribose
    // adenine + OH -> damagedAdenine
    // Deoxyribose + Hydrated e-  -> damagedDeoxyribose
    // adenine + Hydrated e- -> damagedAdenine
    // Deoxyribose + Radical H -> damagedDeoxyribose
    // adenine + Radical H -> damagedAdenine
    // histone + all molecules -> modification(or "damage")
 1.4. G4EmDNAChemistry_option2::ConstructProcesses()
   FindProcess("e-_G4DNAVibExcitation", "e-");
   FindProcess("e-_G4DNAElectronSolvation", "e-");
   // Define processes for molecules
     if(pMoleculeDef != G4H2O::Definition())
       new G4DNABrownianTransportation();
     else
       new G4DNAMolecularDissociation("H2O_DNAMolecularDecay");
       new G4DNAWaterDissociationDisplacer);
   G4DNAChemistryManager::Instance()->Initialize();
 1.5. G4EmDNAChemistry_option2::ConstructTimeStepModel()
   new G4DNASmoluchowskiReactionModel();
   new G4DNAMolecularStepByStepModel();

## CHEMISTRY
1.  G4DNAChemistryManager::Initialize(); (from G4EmDNAChemistry_option2)
  1.1 G4Scheduler::Instance();
    1.1.1. fpModelHandler = new G4ITModelHandler();
    1.1.2. fpTrackingManager = new G4ITTrackingManager();
    1.1.3. fpMessenger = new G4SchedulerMessenger(this);
      fVerboseCmd = new G4UIcmdWithAnInteger("/scheduler/verbose", this);
      fVerboseCmd->SetGuidance(" 0 : Silent (default)");
      fVerboseCmd->SetGuidance(" 1 : Display reactions");
      fVerboseCmd->SetGuidance(" 2 ");
      fReactionSet = G4ITReactionSet::Instance();
  1.2. fpUserChemistryList->ConstructDissociationChannels();
  1.3. fpUserChemistryList->ConstructReactionTable(G4DNAMolecularReactionTable::GetReactionTable());
2. DNADamRunAction::DNADamRunAction()
  if(G4DNAChemistryManager::IsActivated())
  4.1. G4Scheduler::Instance()->SetUserAction(new DNADamTimeStepAction());
  4.2. G4Scheduler::Instance()->SetEndTime(2.5*CLHEP::nanosecond);
  4.3. G4Scheduler::Instance()->SetVerbose(1);
  4.3. DNADamITTrackingInteractivity* itInteractivity = new DNADamITTrackingInteractivity();
      G4Scheduler::Instance()->SetInteractivity(itInteractivity);
  4.4. const DNADamDetectorConstruction* fpDetector = dynamic_cast<const DNADamDetectorConstruction*>(G4RunManager::GetRunManager()->GetUserDetectorConstruction());
      G4DNAChemistryManager::Instance()->SetGun(fpDetector->GetGun());

