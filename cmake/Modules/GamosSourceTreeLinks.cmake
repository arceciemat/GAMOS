# Script run at build time (cmake -P), at every "make": creates the links in the source tree
#   -DSOURCE_DIR=<GAMOS source dir> -DLINKS=<link>=<target>,<link>=<target>,...
# <link> is relative to SOURCE_DIR; <target> is absolute (the link is relative to the link directory).
# An existing directory or file (e.g. from the GNUmake build) is renamed to <link>.gmake
string(REPLACE "," ";" _links "${LINKS}")
foreach(_pair ${_links})
  string(FIND "${_pair}" "=" _eq)
  string(SUBSTRING "${_pair}" 0 ${_eq} _link)
  math(EXPR _eq "${_eq}+1")
  string(SUBSTRING "${_pair}" ${_eq} -1 _target)
  set(_l "${SOURCE_DIR}/${_link}")
  get_filename_component(_ldir "${_l}" DIRECTORY)
  file(MAKE_DIRECTORY "${_ldir}")
  file(RELATIVE_PATH _rel "${_ldir}" "${_target}")
  if(IS_SYMLINK "${_l}")
    file(READ_SYMLINK "${_l}" _cur)
    if(_cur STREQUAL _rel)
      continue()
    endif()
    file(REMOVE "${_l}")
  elseif(EXISTS "${_l}")
    if(EXISTS "${_l}.gmake")
      message(WARNING "${_link} exists and ${_link}.gmake also exists: link ${_link} -> ${_rel} NOT created")
      continue()
    endif()
    file(RENAME "${_l}" "${_l}.gmake")
    message(STATUS "Moved ${_link} to ${_link}.gmake")
  endif()
  file(CREATE_LINK "${_rel}" "${_l}" SYMBOLIC)
  message(STATUS "Link ${_link} -> ${_rel}")
endforeach()
